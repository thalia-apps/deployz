# Deployz environment — placeholders only. Copy to .env and fill in real values.
# .env is gitignored; never commit secrets.

# --- Database (packages/db) ---
# When unset, apps/api falls back to a file-backed PGlite dev database at
# packages/db/.pgdata (migrations auto-applied at startup).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deployz

# --- API / Web ports ---
API_PORT=3001
WEB_PORT=3000

# --- Origins ---
# Production runs three hostnames off one registrable domain:
#   deployz.dev      marketing  (MARKETING_URL / NEXT_PUBLIC_MARKETING_HOST)
#   app.deployz.dev  dashboard  (WEB_URL / NEXT_PUBLIC_APP_HOST)
#   api.deployz.dev  API        (API_URL)
# Leave every value at its localhost default for local development: that is
# what keeps the host split, the cross-subdomain cookie and the Secure flag
# switched off, which is what makes localhost work.
#
# API_URL is read by the API itself (Better Auth baseURL, OAuth callback URLs)
# and by apps/web server components; it never reaches the browser.
# NEXT_PUBLIC_API_URL is the same origin but INLINED INTO THE CLIENT BUNDLE AT
# BUILD TIME — setting it only at runtime leaves the browser calling localhost.
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# The dashboard origin. Invitation emails are built from it, and it is a
# trusted browser origin for CORS and Better Auth.
WEB_URL=http://localhost:3000

# The marketing origin. Also a trusted browser origin. Defaults to WEB_URL
# when unset, which is correct for any single-host deployment.
# MARKETING_URL=https://deployz.dev

# Widens the session cookie from host-scoped to domain-scoped so a cookie set
# by api.deployz.dev is readable by app.deployz.dev. PRODUCTION ONLY — setting
# a Domain on localhost is what breaks the session in development.
# COOKIE_DOMAIN=.deployz.dev

# Renames the session cookie so two control planes can share one cookie
# domain (staging beside production). Optional; unset keeps the default name.
# It must equal NEXT_PUBLIC_COOKIE_PREFIX below, which the web image inlines
# at build time.
# COOKIE_PREFIX=deployz-staging

# Hostnames for the marketing/app split in apps/web middleware. Both must be
# set for the split to activate; unset means one origin serves every route.
# Inlined at build time (middleware runs on the Edge runtime, which has no
# runtime process.env for anything but NEXT_PUBLIC_*).
# NEXT_PUBLIC_MARKETING_HOST=deployz.dev
# NEXT_PUBLIC_APP_HOST=app.deployz.dev
# NEXT_PUBLIC_SITE_URL=https://deployz.dev
# The session-cookie name prefix the middleware looks for. It must equal COOKIE_PREFIX
# above. It is inlined at build time, so a new value needs a new web image.
# NEXT_PUBLIC_COOKIE_PREFIX=deployz-staging

# --- Auth (Better Auth: email/password + GitHub OAuth + organization) ---
# BETTER_AUTH_URL is the AUTH SERVER origin (the Fastify API), used for OAuth
# callback URLs — not the web app origin.
BETTER_AUTH_SECRET=replace_me
BETTER_AUTH_URL=http://localhost:3001
GITHUB_CLIENT_ID=replace_me
GITHUB_CLIENT_SECRET=replace_me

# --- Transactional email (team invitations, membership changes) ---
# A verified AWS SES sender address. When unset, emails are logged, not sent.
# Verified in the SES account that AWS_SES_ACCESS_KEY_ID belongs to (below),
# which is NOT the account the control plane runs in.
EMAIL_FROM=info@e.deployz.dev

# --- GitHub App (installation / trust flow) ---
# The App's "Setup URL" must be https://api.deployz.dev/api/github/setup with
# "Redirect on update" ON. That redirect is where an installation is bound to
# a Deployz organization: it is the only moment where GitHub's installation id
# and the vendor's session are both present. Without it the App can be
# installed but no repository ever appears in the dashboard.
GITHUB_APP_ID=replace_me
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nreplace_me\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace_me

# --- AWS / CDK (control plane, us-east-1) ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=replace_me
CDK_DEFAULT_ACCOUNT=replace_me
CDK_DEFAULT_REGION=us-east-1

# --- AI explanations (Cloudflare AI Gateway) ---
# Plain-English what/why/fix over the deterministic §61 failure code. When any
# of these is unset, diagnostics fall back to deterministic remediation
# guidance — the feature degrades, it never fails.
#
# The unified /compat endpoint, so switching provider is a model-string change:
AI_GATEWAY_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/compat
# Provider-qualified model id. Optional — defaults to the DeepSeek model below.
AI_MODEL=workers-ai/@cf/deepseek-ai/deepseek-v4-flash-0731
# The upstream provider's key -> Authorization: Bearer. Required.
# For workers-ai this is a Cloudflare API token with Workers AI access.
AI_PROVIDER_API_KEY=replace_me
# The GATEWAY's own token -> cf-aig-authorization: Bearer. Set this ONLY if the
# gateway has Authenticated Gateway switched on in the Cloudflare dashboard: an
# unauthenticated gateway answers 401 to a cf-aig-authorization header it
# cannot validate. Must differ from AI_PROVIDER_API_KEY — they authenticate
# different hops, and identical values are rejected as a copy-paste error.
# AI_GATEWAY_TOKEN=replace_me

# --- Fix instructions (coding-agent prompt) ---
# Generated on their own model, never on a fallback. "openrouter" (the
# default) needs OPENROUTER_API_KEY; without it fix instructions answer 503.
# "gateway" is the rollback to the shared gateway above and its AI_MODEL.
# FIX_INSTRUCTIONS_AI_PROVIDER=openrouter
# FIX_INSTRUCTIONS_AI_MODEL=anthropic/claude-opus-5.5
# OPENROUTER_API_KEY=replace_me
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Jev shadow client (typed decision model) ---
# Shadow-mode only: nothing in the product acts on Jev answers yet, so a
# missing or partial config just keeps the client off. Routed through the
# SAME Cloudflare AI Gateway as above, on its `typesafe-ai` custom provider
# (rooted at https://api.typesafe.ai; the client appends /v1/systemone).
# JEV_ENABLED=true
# JEV_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/custom-typesafe-ai
# The TypeSafe API key -> Authorization: Bearer (the gateway forwards it).
# Required when enabled.
# JEV_API_KEY=replace_me
# Model id. Optional — defaults to jev-latest, the alias for the current
# version (the response echoes the resolved versioned id).
# JEV_MODEL=jev-latest
# Per-attempt timeout in ms. Optional — defaults to 10000.
# JEV_TIMEOUT_MS=10000
# The gateway's own token is the shared AI_GATEWAY_TOKEN above (same gateway) —
# only needed when the gateway has authentication switched on.

# --- Deploying: CI only ---
# Nothing in this file reaches production. packages/cdk/bin/deployz.ts refuses
# to run outside GitHub Actions, so `cdk deploy` from a laptop is blocked
# before it touches AWS; .github/workflows/deploy-api.yml supplies the Lambda's
# entire environment from repository secrets. Keep every value here at its
# localhost default — that is all this file is for now.
#
# To inspect the stack locally, opt in: `cdk diff Deployz -c local=true`. That
# flag also re-enables deploy (the CDK CLI does not tell the app which command
# invoked it), so a deploy behind it loads .env and then a sibling
# .env.production over the top — which must carry EVERY key the API needs,
# because collectEnvVars() replaces the deployed environment rather than
# merging with it. Prefer the workflow.
#
# GITHUB_FIXTURE_MODE needs no entry anywhere: it is not in the CDK env
# allowlist at all, so no .env can ship fixture data to a real tenant.

# --- Customer bootstrap template ---
# Public HTTPS URL of the published bootstrap template. Produced by
# `pnpm --filter @deployz/cdk run publish:bootstrap`, which synthesizes the
# stack, repacks it to be self-contained, uploads it plus its Lambda assets to
# the control plane's public template bucket, and prints this value.
# Until it is set the API hands out NO install link (quickCreateUrl: null) and
# the install page says so — a link to a template CloudFormation cannot fetch
# fails inside the customer's own console with nothing they can act on.
# BOOTSTRAP_TEMPLATE_URL=https://<bucket>.s3.us-east-1.amazonaws.com/bootstrap/v1/bootstrap-template-v1.json

# --- API custom domain (optional) ---
# Set both to map the HTTP API onto a custom hostname. The certificate is NOT
# created by CDK: DNS is on Cloudflare, so request it out of band
# (`aws acm request-certificate --region us-east-1 --domain-name api.deployz.dev
# --validation-method DNS`), add the validation CNAME, wait for ISSUED, then
# put the ARN here. Leaving these unset deploys the API on its generated
# execute-api URL, which is also the fallback during a DNS cutover.
#
# REQUIRED for the production stack. The DomainName construct is conditional
# on both values, so a `cdk deploy` run from an environment that is missing
# them DELETES the existing api.deployz.dev mapping and takes the API offline
# until a deploy that has them puts it back (with a new regional domain name
# for the Cloudflare CNAME).
# API_DOMAIN_NAME=api.deployz.dev
# API_CERTIFICATE_ARN=arn:aws:acm:us-east-1:000000000000:certificate/replace_me

# --- Cloudflare DNS (default-HTTPS runtime config) ---
# The production deployz.dev zone is on Cloudflare and is where the
# default-HTTPS flow writes each deployment's ACM-validation and ALB-routing
# CNAME records. There is no CDK IAM grant — the edit token authenticates. All
# four are supplied by .github/workflows/deploy-api.yml (zone id/name + prefix
# hardcoded, token from the CLOUDFLARE_ZONE_EDIT_API_TOKEN repository secret).
# Missing locally = the Cloudflare flow stays off; only the token is a real
# secret.
CLOUDFLARE_ZONE_ID=bf69c0d8524ef2c5cfbc6e5d33fb7cae
CLOUDFLARE_ZONE_NAME=deployz.dev
# The control plane makes, finds and deletes only <prefix><id>.<zone> hostnames.
DEPLOYZ_DEFAULT_HOSTNAME_PREFIX=d-
# CLOUDFLARE_ZONE_EDIT_API_TOKEN=

# --- Transactional email credentials (SES) ---
# Read by the API Lambda through the CDK env allowlist. NOTE: that allowlist
# builds the Lambda environment from this file alone — a key missing here is
# REMOVED from the deployed function, it is not left as-is.
AWS_SES_ACCESS_KEY_ID=replace_me
AWS_SES_SECRET_ACCESS_KEY=replace_me

# --- Paddle billing ---
# Optional at boot: leaving PADDLE_API_KEY unset disables billing entirely
# (every billing surface reports BILLING_DISABLED). Once it IS set, the other
# four keys below are required and validated at startup — a half-configured
# provider fails clearly instead of silently no-oping. Price ids are
# documented in docs/billing/paddle-catalog.md; never hardcode a real one.
PADDLE_API_KEY=test_replace_me
PADDLE_WEBHOOK_SECRET=test_replace_me
PADDLE_CLIENT_TOKEN=pdl_sdbx_replace_me
# The two SANDBOX price ids (docs/billing/paddle-catalog.md). Production has
# its own ids — never reuse these there.
PADDLE_PRICE_PLATFORM=pri_01m20257wy8pbwhbarybef5d7z
PADDLE_PRICE_DEPLOYMENT=pri_01m202585w1nb1bcgmnvbx4bv3
PADDLE_ENVIRONMENT=sandbox

# Kill switch for the PRODUCTION-deployment subscription gate. Set it to
# `off` for an incident where Paddle state is wrong or unreachable and
# customers must not be blocked: every organization can then deploy to
# production whatever its subscription status. Any other value — and the
# empty value below, which keeps the key out of the deployed Lambda —
# enforces. Nothing else in billing changes.
BILLING_ENFORCEMENT=
