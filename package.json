{
  "name": "deployz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e": "node scripts/e2e.mjs",
    "e2e:scenarios": "node scripts/e2e.mjs --scenarios",
    "test:affected": "node scripts/test-affected.mjs",
    "test:escalation": "node scripts/test-affected.mjs --escalation",
    "test:selector": "node --test scripts/test-affected.test.mjs",
    "test:static": "node --test scripts/production-safety.test.mjs scripts/e2e-modes.test.mjs",
    "e2e:fresh": "node scripts/e2e.mjs --mode=fresh",
    "e2e:canary:versions": "node scripts/e2e.mjs --mode=canary-versions",
    "lint": "turbo run lint",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "synth:smoke": "node packages/cdk/scripts/bundle-smoke.mjs",
    "typecheck:scripts": "tsc --noEmit -p scripts/customer-reset/tsconfig.json && tsc --noEmit -p scripts/repository-compatibility/tsconfig.json && tsc --noEmit -p scripts/repository-deployment/tsconfig.json && tsc --noEmit -p scripts/version-canary/tsconfig.json && tsc --noEmit -p scripts/jev-eval/tsconfig.json && tsc --noEmit -p scripts/remediation-benchmark/tsconfig.json && tsc --noEmit -p scripts/run-and-check/tsconfig.json",
    "dev": "turbo run dev",
    "admin:customer-cleanup": "tsx scripts/customer-reset/index.ts",
    "canary:fixture-repo": "tsx scripts/version-canary/fixture-repo.ts",
    "benchmark:compat": "tsx scripts/repository-compatibility/index.ts",
    "benchmark:deploy": "tsx scripts/repository-deployment/index.ts",
    "benchmark:remediation": "tsx scripts/remediation-benchmark/index.ts",
    "jev:eval": "tsx scripts/jev-eval/index.ts",
    "runcheck:preflight": "tsx scripts/run-and-check/src/cli.ts preflight",
    "runcheck:analyse": "tsx scripts/run-and-check/src/cli.ts analyse",
    "runcheck:observe": "tsx scripts/run-and-check/src/cli.ts observe",
    "runcheck:claims": "tsx scripts/run-and-check/src/cli.ts claims",
    "runcheck:full": "tsx scripts/run-and-check/src/cli.ts full",
    "runcheck:fixtures": "tsx scripts/run-and-check/src/cli.ts fixtures"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1115.0",
    "@aws-sdk/client-elasticache": "^3.1115.0",
    "@aws-sdk/client-eventbridge": "^3.1115.0",
    "@aws-sdk/client-rds": "^3.1115.0",
    "@aws-sdk/client-s3": "^3.1115.0",
    "@deployz/analysis": "workspace:*",
    "@deployz/api": "workspace:*",
    "@deployz/contracts": "workspace:*",
    "@deployz/db": "workspace:*",
    "@deployz/relay": "workspace:*",
    "@electric-sql/pglite": "^0.5.5",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "aws-cdk": "^2.1138.0",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "pg": "^8.13.0",
    "turbo": "^2.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.4.3"
  }
}
